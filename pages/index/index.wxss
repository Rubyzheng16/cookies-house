/* 碎片收纳主界面样式 */
.page-root {
  width: 100%;
  min-height: 100vh;
  background-color: #FCE4EC;
  background-image: radial-gradient(#F8BBD0 2.5px, transparent 2.5px);
  background-size: 45px 45px;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.page-root.container {
  padding: 20rpx;
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 40rpx;
}

.header-content {
  height: 120rpx;
  background: repeating-linear-gradient(
    45deg,
    #5D4037 0px,
    #5D4037 20rpx,
    #6D4C41 20rpx,
    #6D4C41 40rpx
  );
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  position: relative;
  border-bottom: 16rpx solid #3E2723;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  border-top: 3rpx solid rgba(255, 249, 196, 0.8);
  box-sizing: border-box;
}

/* 左右按钮等宽，保证标题居中 */
.header-content .calendar-btn {
  flex: 0 0 96rpx;
}
.header-content .edit-btn {
  flex: 0 0 96rpx;
  min-width: 96rpx;
  width: 96rpx;
  padding: 12rpx 0;
  font-size: 24rpx;
}

.header-title {
  color: white;
  font-size: 48rpx;
  font-weight: bold;
  letter-spacing: 8rpx;
  text-shadow: 4rpx 4rpx #3E2723, -2rpx -2rpx 0 #FFF9C4;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
}

.workbench {
  position: relative;
  overflow: visible;
  box-sizing: border-box;
}

.workbench-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  display: flex;
  overflow: hidden;
}

.workbench-top::before {
  display: none;
}

.input-area {
  position: relative;
  margin-top: 32rpx;
  width: 100%;
  box-sizing: border-box;
  background: rgba(255, 249, 196, 0.9);
  border-radius: 40rpx 40rpx 0 0;
  padding-top: 0;
  overflow: visible;
}

.input-area::before {
  content: '';
  position: absolute;
  top: -70rpx;
  left: 0;
  right: 0;
  height: 66rpx;
  background: white;
  border-radius: 40rpx 40rpx 0 0;
  overflow: hidden;
  background-image: 
    radial-gradient(circle at 45rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx),
    radial-gradient(circle at 135rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx),
    radial-gradient(circle at 225rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx),
    radial-gradient(circle at 315rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx),
    radial-gradient(circle at 405rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx),
    radial-gradient(circle at 495rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx),
    radial-gradient(circle at 585rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx),
    radial-gradient(circle at 675rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx);
  background-size: 90rpx 66rpx;
  background-position: 0 0, 90rpx 0, 180rpx 0, 270rpx 0, 360rpx 0, 450rpx 0, 540rpx 0, 630rpx 0;
  background-repeat: repeat-x;
  z-index: 1;
}

.input-textarea {
  width: 100%;
  min-height: 224rpx;
  background: transparent;
  border: none;
  color: #3E2723;
  font-size: 36rpx;
  padding: 16rpx;
  line-height: 1.6;
  text-align: left;
}

.input-icons {
  position: absolute;
  bottom: 16rpx;
  right: 20rpx;
  display: flex;
  gap: 20rpx;
  z-index: 10;
}

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s;
}

.icon-btn:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.6);
}

.icon {
  font-size: 40rpx;
}

.ref-toggle {
  display: flex;
  justify-content: center;
  margin: 32rpx 0;
}

.ref-btn {
  background: rgba(161, 136, 127, 0.2);
  padding: 8rpx 32rpx;
  border-radius: 50rpx;
  font-size: 20rpx;
  color: #3E2723;
  font-weight: bold;
  border: none;
}

.ref-content {
  margin-bottom: 48rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 60rpx;
  border: 4rpx dashed rgba(161, 136, 127, 0.4);
}

.ref-quadrant-visual {
  position: relative;
  background: rgba(255, 255, 255, 0.4);
  padding: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  min-height: 600rpx;
}

.ref-quadrant-container {
  position: relative;
  width: 100%;
  height: 600rpx;
}

/* 横线 */
.ref-quadrant-line-horizontal {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 2rpx;
  background: rgba(62, 39, 35, 0.3);
  z-index: 1;
  transform: translateY(-50%);
}

/* 竖线 */
.ref-quadrant-line-vertical {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: rgba(62, 39, 35, 0.3);
  z-index: 1;
  transform: translateX(-50%);
}

.ref-quadrant-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  width: 100%;
  height: 100%;
  position: relative;
  z-index: 0;
}

.ref-quadrant-cell {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  padding: 16rpx;
  position: relative;
  border: 1rpx solid rgba(62, 39, 35, 0.1);
  overflow-y: auto;
}

.ref-quadrant-1 {
  background: rgba(255, 128, 171, 0.1);
  border-top-right-radius: 24rpx;
}

.ref-quadrant-2 {
  background: rgba(129, 199, 132, 0.1);
  border-top-left-radius: 24rpx;
}

.ref-quadrant-3 {
  background: rgba(255, 235, 118, 0.1);
  border-bottom-right-radius: 24rpx;
}

.ref-quadrant-4 {
  background: rgba(179, 157, 219, 0.1);
  border-bottom-left-radius: 24rpx;
}

.ref-quadrant-cell-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
  width: 100%;
}

.ref-quadrant-cell-title {
  font-size: 22rpx;
  font-weight: bold;
  color: #3E2723;
  line-height: 1.3;
  text-align: center;
}

.ref-quadrant-cell-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: 100%;
  flex: 1;
}

.ref-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.ref-detail-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 20rpx;
  line-height: 1.4;
}

.ref-detail-label {
  color: #6D4C41;
  font-weight: bold;
  font-size: 18rpx;
}

.ref-detail-text {
  color: rgba(62, 39, 35, 0.8);
  font-size: 18rpx;
}

/* 坐标轴标签 */
.ref-quadrant-axis-label {
  position: absolute;
  font-size: 20rpx;
  color: #6D4C41;
  font-weight: bold;
  opacity: 0.6;
  z-index: 2;
}

.ref-quadrant-axis-label.axis-important {
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
}

.ref-quadrant-axis-label.axis-urgent {
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
}

.quadrant-buttons {
  display: flex;
  flex-direction: row;
  gap: 6rpx;
  margin: 16rpx 0 24rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  padding: 0;
  justify-content: space-between;
}

.quadrant-btn {
  flex: 1;
  min-width: 0;
  max-width: calc(25% - 4.5rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 4rpx;
  border-radius: 16rpx;
  border: none;
  transition: all 0.3s;
  opacity: 0.8;
  box-sizing: border-box;
  overflow: hidden;
}

.quadrant-btn.selected {
  opacity: 1;
  transform: scale(1.02);
  box-shadow: 0 0 0 4rpx white;
}

.quadrant-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
  flex-shrink: 0;
}

.quadrant-label {
  font-size: 20rpx;
  font-weight: bold;
  color: #3E2723;
  text-align: center;
  line-height: 1.2;
  word-break: keep-all;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  max-width: 100%;
  padding: 0 2rpx;
}

.confirm-btn {
  width: calc(100% - 48rpx);
  max-width: calc(100% - 48rpx);
  padding: 24rpx 32rpx;
  border-radius: 32rpx;
  font-weight: bold;
  color: white;
  border: none;
  font-size: 28rpx;
  margin: 24rpx auto 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
  display: block;
}

.confirm-btn.active {
  background-color: #FFB74D;
  box-shadow: 0 4rpx 16rpx rgba(255, 183, 77, 0.3);
}

.confirm-btn.disabled {
  background-color: #E0E0E0;
  color: #999999;
  opacity: 0.6;
}

.confirm-btn::after {
  border: none;
}

/* 文件夹网格 */
.folders-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx;
  margin-top: 40rpx;
  padding: 0;
  box-sizing: border-box;
}

.folder-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  background: transparent;
}

.folder-image-wrapper {
  width: 100%;
  display: flex;
  justify-content: center;
  transition: transform 0.3s;
}

.folder-card:active .folder-image-wrapper {
  transform: scale(0.95);
}

.folder-image {
  width: 100%;
  display: block;
  /* 完整显示抠图，透明区域透出背景 */
}

.folder-date-label {
  color: #3E2723;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  margin-top: 12rpx;
}

.folder-delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 0, 0, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  transition: all 0.2s;
  pointer-events: auto;
}

.folder-delete-btn:active {
  background: rgba(255, 0, 0, 0.4);
  transform: scale(0.85);
}

.delete-icon {
  color: #d32f2f;
  font-size: 44rpx;
  font-weight: bold;
  line-height: 1;
}

.baking-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(4rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.baking-modal {
  background: white;
  padding: 64rpx;
  border-radius: 80rpx;
  text-align: center;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.3);
  border: 16rpx solid #FFF9C4;
}

.baking-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 32rpx;
  animation: pulse 1s infinite;
}

.baking-text {
  color: #3E2723;
  font-weight: bold;
  font-size: 40rpx;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
}

/* 日历按钮 */
.calendar-btn {
  width: 80rpx;
  height: 80rpx;
  min-width: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  flex-shrink: 0;
  z-index: 10;
}

.calendar-btn:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.3);
}

.calendar-icon {
  font-size: 48rpx;
}

/* 日历弹窗 */
.calendar-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
}

.calendar-content {
  width: 90%;
  max-width: 700rpx;
  background: white;
  border-radius: 40rpx;
  padding: 40rpx;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.3);
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.calendar-header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.calendar-nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(93, 64, 55, 0.15);
  border-radius: 50%;
  font-size: 32rpx;
  color: #3E2723;
  font-weight: bold;
}

.calendar-nav-btn:active {
  background: rgba(93, 64, 55, 0.3);
}

.calendar-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #3E2723;
  flex: 1;
  text-align: center;
}

.edit-btn {
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: white;
  min-width: 80rpx;
  text-align: center;
}

.edit-btn.edit-active {
  background: rgba(255, 249, 196, 0.9);
  color: #3E2723;
}

.edit-btn:active {
  transform: scale(0.95);
}

.calendar-close {
  font-size: 48rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f5f5;
}

.calendar-grid {
  margin-bottom: 32rpx;
}

.calendar-month {
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #3E2723;
  margin-bottom: 24rpx;
}

.calendar-weekdays {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.weekday {
  width: 80rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  font-weight: bold;
}

.calendar-days {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.calendar-day {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  position: relative;
  background-color: white;
  transition: all 0.3s;
}

.calendar-day.other-month {
  opacity: 0.3;
}

.calendar-day.day-dark .day-number {
  color: #FFFFFF;
}

.calendar-day.today {
  border: 2rpx solid #6D4C41;
}

.calendar-day.selected {
  border: 3rpx solid #FF80AB;
  transform: scale(1.1);
}

.calendar-day:active {
  transform: scale(0.9);
}

.day-number {
  font-size: 28rpx;
  color: #3E2723;
  font-weight: bold;
}

.day-dot {
  position: absolute;
  bottom: 8rpx;
  width: 8rpx;
  height: 8rpx;
  background: #FF80AB;
  border-radius: 50%;
}

.search-btn {
  width: 100%;
  padding: 24rpx 48rpx;
  background: #6D4C41;
  color: white;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.search-btn::after {
  border: none;
}

