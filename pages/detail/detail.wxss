/* 详情页面样式 - 时间轴布局 */
page {
  background-color: #FCE4EC;
  min-height: 100vh;
}

.container {
  padding: 0;
  padding-bottom: 200rpx;
}

.header {
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
  background: #FCE4EC;
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.header-title-section {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
  margin-left: 20rpx;
}

.header-date {
  color: #333;
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1.4;
  position: relative;
  padding-bottom: 8rpx;
}

.header-date::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: linear-gradient(90deg, #4CAF50 0%, #81C784 100%);
  border-radius: 2rpx;
}

.header-time {
  color: rgba(0, 0, 0, 0.6);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  flex-shrink: 0;
  z-index: 10;
}

.back-btn:active {
  transform: scale(0.9);
  background: rgba(0, 0, 0, 0.1);
}

.back-icon {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
}

.header-spacer {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
}

.calendar-btn {
  width: 60rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  flex-shrink: 0;
  z-index: 10;
}

.calendar-btn:active {
  transform: scale(0.9);
  background: rgba(0, 0, 0, 0.1);
}

.calendar-icon {
  font-size: 36rpx;
}

/* 四象限图 */
.quadrant-section {
  margin: 0 30rpx 24rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  border: 4rpx dashed rgba(93, 64, 55, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.quadrant-chart {
  width: 100%;
}

.quadrant-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 2rpx;
  height: 280rpx;
}

.quadrant-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  border-radius: 12rpx;
  min-height: 100rpx;
}

.quadrant-1 {
  background: rgba(255, 128, 171, 0.15);
  border-top-right-radius: 16rpx;
}

.quadrant-2 {
  background: rgba(129, 199, 132, 0.15);
  border-top-left-radius: 16rpx;
}

.quadrant-3 {
  background: rgba(255, 235, 118, 0.25);
  border-bottom-right-radius: 16rpx;
}

.quadrant-4 {
  background: rgba(179, 157, 219, 0.15);
  border-bottom-left-radius: 16rpx;
}

.quadrant-label {
  font-size: 22rpx;
  font-weight: bold;
  color: #3E2723;
  margin-bottom: 12rpx;
  opacity: 0.9;
}

.quadrant-dots {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: center;
  align-items: center;
}

.quadrant-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* 任务时间块 + 碎碎念 左右布局 */
.task-blocks-section {
  margin: 0 30rpx 24rpx;
  padding: 0;
}

.task-block-row {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.task-block {
  flex: 1;
  min-width: 0;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.task-block-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.task-block-icon {
  font-size: 36rpx;
  line-height: 1.2;
}

.task-block-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.5;
}

.task-block-time {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.6);
}

.task-mumblings {
  flex: 0 0 42%;
  max-width: 280rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 12rpx 0;
}

.mumbling-chip {
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.mumbling-chip-text {
  font-size: 24rpx;
  color: #333;
  line-height: 1.4;
}

.mumbling-chip-time {
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.5);
}

/* 完成时间 + 用时 */
.entry-completion-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.entry-completion-time {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.6);
}

.entry-duration {
  font-size: 24rpx;
  color: #6D4C41;
}

/* 添加时间按钮 */
.add-time-btn {
  margin-top: 8rpx;
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  align-self: flex-start;
}

.add-time-text {
  font-size: 22rpx;
  color: #6D4C41;
}

/* 添加时间弹窗 */
.time-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10002;
}

.time-modal {
  width: 560rpx;
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
}

.time-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
}

.time-picker-section {
  margin-bottom: 24rpx;
}

.time-picker-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.time-picker-view {
  width: 100%;
  height: 260rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
  line-height: 80rpx;
  height: 80rpx;
}

.time-modal-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.time-modal-btn {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.time-modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.time-modal-btn.confirm {
  background: #6D4C41;
  color: white;
}

/* 时间轴容器 */
.timeline-container {
  position: relative;
  padding: 20rpx 30rpx 60rpx 30rpx;
  background-color: #FCE4EC;
}

/* 小时分组整体 */
.hour-groups {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.hour-group {
  display: flex;
  align-items: flex-start;
}

.hour-label-wrapper {
  width: 120rpx;
  padding-top: 8rpx;
  display: flex;
  justify-content: center;
}

.hour-badge {
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  background-color: #CFD8DC;
}

.hour-label-text {
  font-size: 22rpx;
  color: #333;
}

.hour-content {
  flex: 1;
  position: relative;
  padding-left: 20rpx;
}

.hour-line {
  position: absolute;
  left: 10rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background-color: #4CAF50;
}

/* 右侧内容区域 */
.content-area {
  flex: 1;
  position: relative;
  padding-left: 30rpx;
  padding-top: 0;
}

/* 全天事件区域 */
.all-day-section {
  position: relative;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.all-day-label {
  color: rgba(0, 0, 0, 0.6);
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.all-day-entries {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 时间轴条目 */
.timeline-entries {
  display: none;
}

/* 分钟分组容器 */
.minute-groups {
  margin-top: 4rpx;
}

.minute-group {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.minute-time-wrapper {
  width: 120rpx;
  padding-top: 4rpx;
  display: flex;
  justify-content: center;
}

.minute-time-badge {
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  background-color: #CFD8DC;
}

.minute-time-text {
  font-size: 22rpx;
  color: #333;
}

.minute-group-entries {
  flex: 1;
  padding-left: 20rpx;
}

.minute-group-entries .timeline-item {
  margin-bottom: 12rpx;
}

/* 条目卡片 */
.entry-card {
  padding: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-height: 60rpx;
  margin-bottom: 16rpx;
  background: white;
}

.all-day-card {
  margin-bottom: 0;
}

.entry-header {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  flex: 1;
}

.entry-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

.entry-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.entry-text {
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
  flex: 1;
  display: block;
  width: 100%;
}

.entry-time {
  color: rgba(0, 0, 0, 0.5);
  font-size: 22rpx;
  font-weight: 500;
  margin-top: 4rpx;
}

.entry-image {
  width: 100%;
  max-width: 600rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

/* 多图容器 */
.entry-images-container {
  margin-top: 12rpx;
  width: 100%;
  position: relative;
}

.images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
  position: relative;
}

.entry-image-thumbnail {
  flex: 0 0 calc(50% - 6rpx);
  width: calc(50% - 6rpx);
  height: 200rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

/* 当图片超过4张时，显示更多图片遮罩 */
.more-images-overlay {
  position: absolute;
  bottom: 0;
  right: 0;
  width: calc(50% - 6rpx);
  height: 200rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.more-images-text {
  color: white;
  font-size: 36rpx;
  font-weight: bold;
}

/* 当日日记（文件夹最下方） */
.diary-at-bottom {
  margin: 48rpx 32rpx;
  padding: 32rpx;
  background: #FFFDE7;
  border-radius: 24rpx;
  border: 4rpx solid rgba(109, 76, 65, 0.2);
}

.diary-bottom-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.diary-bottom-icon {
  font-size: 36rpx;
}

.diary-bottom-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #6D4C41;
}

.diary-bottom-body {
  padding: 0;
}

.diary-bottom-content {
  display: block;
  color: #3E2723;
  line-height: 1.8;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.diary-bottom-block {
  margin-top: 20rpx;
}

.diary-bottom-label {
  font-size: 24rpx;
  color: #6D4C41;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.diary-bottom-text {
  color: #3E2723;
  line-height: 1.6;
  font-size: 26rpx;
  display: block;
}

.diary-bottom-text.insight {
  font-style: italic;
  color: #5D4037;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  color: rgba(0, 0, 0, 0.5);
  font-size: 32rpx;
}

/* 详情页加号按钮（放大两倍） */
.detail-add-button {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 240rpx;
  height: 240rpx;
  z-index: 10001;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: env(safe-area-inset-bottom);
}

.detail-add-button .add-button-inner {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FFB74D 0%, #FF9800 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 183, 77, 0.5);
  transition: all 0.3s;
  border: 4rpx solid #6D4C41;
}

.detail-add-button .add-button-inner:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 16rpx rgba(255, 183, 77, 0.3);
}

.detail-add-button .add-icon {
  font-size: 60rpx;
  color: white;
  font-weight: 300;
  line-height: 1;
}

/* 完整按钮图片：整圆替换，无额外装饰（放大两倍） */
.detail-add-button .add-btn-full-image {
  width: 240rpx;
  height: 240rpx;
  display: block;
  transition: transform 0.3s;
}

.detail-add-button:active .add-btn-full-image {
  transform: scale(0.9);
}
