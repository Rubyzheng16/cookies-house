/* 详情页面样式 - 时间轴布局 */
page {
  background-color: #1A1A1A;
  min-height: 100vh;
}

.container {
  padding: 0;
  padding-bottom: 200rpx;
}

.header {
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.header-content {
  height: 100rpx;
  background: #2A2A2A;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  position: relative;
}

.header-title-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.header-date {
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1.2;
}

.header-time {
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  flex-shrink: 0;
  z-index: 10;
}

.back-btn:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.3);
}

.back-icon {
  font-size: 48rpx;
  color: white;
}

.calendar-btn {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  flex-shrink: 0;
  z-index: 10;
}

.calendar-btn:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.3);
}

.calendar-icon {
  font-size: 48rpx;
}

/* 时间轴容器 */
.timeline-container {
  position: relative;
  display: flex;
  min-height: calc(18 * 120rpx); /* 18个小时 * 120rpx */
  background-color: #1A1A1A;
}

/* 左侧时间轴 */
.time-axis {
  position: relative;
  width: 120rpx;
  flex-shrink: 0;
  padding-top: 20rpx;
}

.time-slot {
  position: absolute;
  left: 0;
  width: 100%;
  height: 120rpx;
  display: flex;
  align-items: flex-start;
  padding-left: 20rpx;
}

.time-slot-label {
  color: rgba(255, 255, 255, 0.5);
  font-size: 22rpx;
  font-weight: 500;
}

/* 右侧内容区域 */
.content-area {
  flex: 1;
  position: relative;
  padding-left: 20rpx;
  padding-top: 20rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.1);
}

/* 全天事件区域 */
.all-day-section {
  position: relative;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.all-day-label {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.all-day-entries {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 时间轴条目 */
.timeline-entries {
  position: relative;
  min-height: calc(18 * 120rpx); /* 18个小时 * 120rpx */
}

.timeline-item {
  position: absolute;
  left: 0;
  right: 20rpx;
  width: calc(100% - 20rpx);
}

/* 条目卡片 */
.entry-card {
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-height: 60rpx;
  margin-bottom: 12rpx;
}

.all-day-card {
  margin-bottom: 0;
}

.entry-header {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  flex: 1;
}

.entry-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

.entry-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.entry-text {
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
  flex: 1;
  display: block;
  width: 100%;
}

.entry-time {
  color: rgba(0, 0, 0, 0.5);
  font-size: 22rpx;
  font-weight: 500;
}

.entry-image {
  width: 100%;
  max-width: 600rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  color: rgba(255, 255, 255, 0.6);
  font-size: 32rpx;
}

/* 详情页加号按钮 */
.detail-add-button {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 120rpx;
  z-index: 10001;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0;
}

.detail-add-button .add-button-inner {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FFB74D 0%, #FF9800 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 183, 77, 0.5);
  transition: all 0.3s;
  border: 4rpx solid #6D4C41;
  position: relative;
  top: -50rpx;
}

.detail-add-button .add-button-inner:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 16rpx rgba(255, 183, 77, 0.3);
}

.detail-add-button .add-icon {
  font-size: 60rpx;
  color: white;
  font-weight: 300;
  line-height: 1;
}
