/* 折叠式未来目标管理页面样式 */
.tabs {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 40rpx;
}

.tab-btn {
  padding: 24rpx 48rpx;
  border-radius: 50rpx;
  font-weight: bold;
  border: 8rpx solid transparent;
  background: rgba(255, 255, 255, 0.4);
  color: #6D4C41;
  font-size: 28rpx;
  transform: scale(0.9);
  transition: all 0.3s;
}

.tab-btn.active {
  background: #FFF9C4;
  border-color: #6D4C41;
  color: #3E2723;
  transform: scale(1);
}

.tab-btn::after {
  border: none;
}

.tab-content {
  width: 100%;
}

/* ========== 关于我板块（技能树在顶上，关于我在下，添加词语在照片下方） ========== */
.about-me-section {
  margin-top: 16rpx;
  position: relative;
}

.about-me-section .section-title {
  font-size: 36rpx;
  margin-bottom: 32rpx;
}

.about-me-bubbles-wrap {
  position: relative;
  min-height: 520rpx;
  padding: 24rpx;
}

/* 中央图片区域（圆角矩形，像草图里的中心区） */
.about-me-center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 240rpx;
  height: 280rpx;
  border-radius: 32rpx;
  border: 4rpx solid rgba(129, 199, 132, 0.8);
  background: rgba(255, 255, 255, 0.9);
  overflow: hidden;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.about-me-center.has-image {
  border-color: rgba(109, 76, 65, 0.25);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.about-me-image {
  width: 100%;
  height: 100%;
  display: block;
}

.about-me-upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6D4C41;
  opacity: 0.7;
}

.upload-icon {
  font-size: 56rpx;
  display: block;
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 22rpx;
}

/* 漂浮词语泡泡（绿色手绘感边框，参考图2/3） */
.bubble {
  position: absolute;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  border: 3rpx solid #81C784;
  background: rgba(255, 255, 255, 0.92);
  color: #3E2723;
  max-width: 28%;
  box-sizing: border-box;
  z-index: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bubble-float {
  animation: bubble-float 4s ease-in-out infinite;
}

.bubble:nth-child(odd) {
  animation-delay: 0.5s;
}

.bubble:nth-child(3n) {
  animation-delay: 1s;
}

.bubble:nth-child(4n) {
  animation-delay: 1.5s;
}

@keyframes bubble-float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

.bubble-text {
  font-size: inherit;
}

.add-word-btn {
  margin-top: 32rpx;
  padding: 20rpx 40rpx;
  background: rgba(129, 199, 132, 0.4);
  color: #2E7D32;
  border: 2rpx solid #81C784;
  border-radius: 50rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.add-word-btn::after {
  border: none;
}

/* 原技能树折叠栏（置顶） */
.skill-tree-fold-bar {
  margin-bottom: 24rpx;
  padding: 24rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.5);
  border: 2rpx dashed rgba(109, 76, 65, 0.2);
  border-radius: 24rpx;
}

.fold-bar-text {
  font-size: 26rpx;
  color: #6D4C41;
}

/* 技能树板块（参考品鉴室丰容板块样式） */
.skill-tree-panels {
  margin-top: 24rpx;
}

.skill-tree-panels .section-title,
.skill-analysis-entry .section-title {
  font-size: 32rpx;
  margin-bottom: 24rpx;
  color: #3E2723;
}

.panels-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.panel-card {
  padding: 32rpx;
  border-radius: 32rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.3);
  border: 4rpx solid rgba(109, 76, 65, 0.2);
  transition: all 0.3s;
}

.panel-card:active {
  background: #FFF9C4;
  border-color: #6D4C41;
}

.panel-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.panel-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #3E2723;
  display: block;
}

.panel-desc {
  font-size: 20rpx;
  color: rgba(62, 39, 35, 0.7);
  margin-top: 8rpx;
  display: block;
}

/* 分析入口（参考品鉴室卡片样式） */
.skill-analysis-entry {
  margin-top: 48rpx;
}

.analysis-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: rgba(255, 249, 196, 0.9);
  border: 4rpx solid rgba(161, 136, 127, 0.3);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.analysis-hint {
  font-size: 28rpx;
  color: #3E2723;
}

.analysis-arrow {
  font-size: 32rpx;
  color: #6D4C41;
}

/* 拆解板块（缩小） */
.goal-split-section {
  padding: 24rpx 28rpx 28rpx;
}

.goal-split-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3E2723;
  display: block;
  margin-bottom: 8rpx;
}

.goal-split-subtitle {
  font-size: 22rpx;
  color: #6D4C41;
  opacity: 0.9;
  display: block;
  margin-bottom: 20rpx;
}

.goal-split-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.goal-split-input {
  flex: 1;
  min-height: 64rpx;
  background: rgba(255, 249, 196, 0.6);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  padding: 14rpx 20rpx;
  color: #3E2723;
  font-size: 26rpx;
}

.goal-split-btn {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  background: #6D4C41;
  color: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: bold;
  border: none;
}

.goal-split-btn::after {
  border: none;
}

.goal-split-btn[disabled] {
  opacity: 0.5;
}

/* 长期目标板块：tag 展示 */
.long-term-section {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 32rpx;
  padding: 24rpx;
  border: 4rpx solid rgba(109, 76, 65, 0.12);
}

.long-term-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.long-term-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #3E2723;
}

.long-term-add-btn {
  padding: 4rpx 16rpx;
  background: #6D4C41;
  color: #fff;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  border: none;
}

.long-term-add-btn::after {
  border: none;
}

.goal-tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.goal-tag-row {
  margin: 0;
}

.goal-tag {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background: #FF80AB;
  color: #fff;
  border-radius: 999rpx;
  max-width: 100%;
  box-sizing: border-box;
}

.goal-tag.expanded {
  border-radius: 24rpx 24rpx 0 0;
}

.goal-tag-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goal-tag-close {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 32rpx;
  opacity: 0.9;
}

.goal-tag-detail {
  background: rgba(255, 249, 196, 0.5);
  border: 2rpx solid rgba(109, 76, 65, 0.1);
  border-top: none;
  border-radius: 0 0 24rpx 24rpx;
  padding: 16rpx 20rpx 20rpx;
}

.goal-tag-step {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
  font-size: 24rpx;
  color: #3E2723;
}

.goal-tag-step.completed {
  opacity: 0.6;
  text-decoration: line-through;
}

.goal-tag-step-text {
  flex: 1;
  min-width: 0;
}

.goal-tag-empty-steps {
  font-size: 24rpx;
  color: rgba(62, 39, 35, 0.5);
  padding: 12rpx 0;
}

.long-term-empty {
  text-align: center;
  padding: 32rpx 0;
}

.long-term-empty-text {
  font-size: 26rpx;
  color: rgba(62, 39, 35, 0.5);
}

.input-section {
  text-align: center;
}

.section-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #3E2723;
  margin-bottom: 16rpx;
  display: block;
}

.section-subtitle {
  font-size: 24rpx;
  color: #6D4C41;
  font-style: italic;
  margin-bottom: 48rpx;
  display: block;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.goal-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  background: rgba(255, 249, 196, 0.5);
  border: 4rpx solid white;
  border-radius: 32rpx;
  padding: 24rpx;
  color: #3E2723;
  font-size: 28rpx;
  line-height: 1.5;
}

.split-btn {
  width: 100%;
  background: #6D4C41;
  color: white;
  padding: 24rpx 48rpx;
  border-radius: 32rpx;
  font-weight: bold;
  font-size: 28rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.split-btn[disabled] {
  opacity: 0.5;
}

.quadrant-selector {
  margin-top: 32rpx;
  padding: 20rpx 16rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 24rpx;
  box-sizing: border-box;
}

.selector-label {
  font-size: 24rpx;
  color: #3E2723;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.quadrant-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rpx;
  margin: 0 20% 0 -5%;
  width: 15%;
  max-width: 15%;
  box-sizing: border-box;
  padding: 0;
}

.quadrant-btn-small {
  width: 100%;
  max-width: 100%;
  padding: 16rpx 2rpx;
  border-radius: 16rpx;
  font-size: 16rpx;
  font-weight: bold;
  color: white;
  border: 2rpx solid;
  opacity: 0.7;
  transition: all 0.3s;
  box-sizing: border-box;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
}

.quadrant-btn-small.selected {
  opacity: 1;
  transform: scale(1.05);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.quadrant-btn-small::after {
  border: none;
}

.goal-title-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  width: 100%;
}

/* 标题居中、横向排列，且不溢出 */
.goal-title {
  writing-mode: horizontal-tb;
  display: inline-block;
  white-space: normal;
  word-break: break-all;
  font-size: 36rpx;
  font-weight: bold;
  color: #3E2723;
  max-width: 100%;
  overflow-wrap: break-word;
}

.goal-type-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 板块最右上角的小×删除（贴边） */
.goal-delete-x {
  position: absolute;
  top: 0;
  right: -100rpx;
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  margin: 0;
  line-height: 72rpx;
  font-size: 44rpx;
  color: #999;
  background: transparent;
  border: none;
  border-radius: 0 56rpx 0 24rpx;
  z-index: 10;
}

.goal-delete-x::after {
  border: none;
}

.goal-delete-x:active {
  color: #B71C1C;
  background: rgba(183, 28, 28, 0.1);
}

.goals-list {
  margin-top: 40rpx;
  overflow: visible;
}

.goal-card {
  background: rgba(255, 255, 255, 0.6);
  padding: 40rpx 36rpx 48rpx;
  padding-top: 56rpx;
  border-radius: 64rpx;
  border: 8rpx solid white;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 48rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.goal-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-width: 0;
}

/* 糖果罐：固定宽高，不随外框变化；上下缩小后垂直居中，完成前后大小一致 */
.candy-jar {
  width: 136rpx;
  height: 200rpx;
  flex-shrink: 0;
  align-self: center;
  background: rgba(255, 255, 255, 0.4);
  border: 4rpx solid white;
  border-radius: 0 0 32rpx 32rpx;
  border-top-left-radius: 16rpx;
  border-top-right-radius: 16rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: visible;
}

.jar-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 24rpx;
  background: rgba(255, 255, 255, 0.6);
}

.jar-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 4rpx;
  padding: 10rpx;
  align-items: flex-end;
  align-content: flex-end;
  overflow: hidden;
}

.candy {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* 堆叠糖果：轻微阴影增强层次感 */
.candy-stack {
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

/* 掉落动画：从上方落下，带重力加速 + 落地碰撞 bounce */
.candy-drop {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  animation: candy-fall 880ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes candy-fall {
  0% {
    transform: translate(-50%, -220rpx) scale(0.8);
    opacity: 0;
  }
  8% {
    opacity: 1;
  }
  70% {
    /* 重力加速：落至糖果层顶部，不超出罐底 */
    transform: translate(-50%, 0) scale(1);
  }
  85% {
    /* 碰撞 bounce：落地后反弹一点（向上） */
    transform: translate(-50%, -16rpx) scale(1.05);
  }
  100% {
    transform: translate(-50%, 0) scale(1);
    opacity: 1;
  }
}

.goal-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

/* 标题行：名称居中，右侧为×留空 */
.goal-header {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
  padding-right: 72rpx;
  min-width: 0;
}

.expand-section {
  margin-top: 24rpx;
  width: 100%;
}

.expand-btn {
  font-size: 24rpx;
  color: #6D4C41;
  background: rgba(255, 255, 255, 0.5);
  padding: 12rpx 24rpx;
  border-radius: 50rpx;
  border: none;
  width: 100%;
}

.expand-btn::after {
  border: none;
}

.delete-btn {
  font-size: 22rpx;
  color: #B71C1C;
  background: transparent;
  padding: 4rpx 8rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(183, 28, 28, 0.3);
}

.delete-btn::after {
  border: none;
}

.completed-badge {
  background: #C8E6C9;
  color: #2E7D32;
  padding: 8rpx 24rpx;
  border-radius: 50rpx;
  font-size: 20rpx;
  font-weight: bold;
  width: fit-content;
  animation: bounce 1s infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

.next-step-preview {
  margin-top: 16rpx;
}

/* 展开后：思维导图区域，展示所有子目标（含已完成，可当历史记录查看） */
.mindmap-section {
  margin-top: 24rpx;
  padding: 24rpx 0 0;
  border-top: 2rpx dashed rgba(109, 76, 65, 0.2);
  min-height: 80rpx;
}

.history-label {
  font-size: 24rpx;
  color: #6D4C41;
  opacity: 0.85;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.mindmap-node {
  margin-bottom: 32rpx;
  position: relative;
}

.mindmap-branch {
  width: 4rpx;
  height: 24rpx;
  background: linear-gradient(to bottom, #FF80AB, #B39DDB);
  margin-bottom: 8rpx;
  border-radius: 2rpx;
}

.mindmap-subtitle {
  font-size: 26rpx;
  font-weight: bold;
  color: #6D4C41;
  display: block;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
}

.mindmap-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 16rpx 16rpx 32rpx;
  margin-left: 16rpx;
  border-left: 4rpx solid #FFF176;
  border-radius: 0 24rpx 24rpx 0;
  background: #FFFDE7;
  margin-bottom: 12rpx;
  font-size: 24rpx;
}

.mindmap-step.completed {
  background: #F5F5F5;
  opacity: 0.6;
  text-decoration: line-through;
  font-style: italic;
  border-left-color: #C8E6C9;
}

.mindmap-connector {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FF80AB;
  flex-shrink: 0;
}

.mindmap-step .step-text {
  flex: 1;
  min-width: 0;
  word-break: break-all;
  overflow-wrap: break-word;
  color: #3E2723;
}

.next-step-item {
  background: #FFFDE7;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid #FFF176;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-width: 0;
  overflow: hidden;
}

.next-step-content {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  padding-right: 8rpx;
}

.next-step-label {
  font-size: 20rpx;
  color: #6D4C41;
  opacity: 0.6;
  display: block;
  margin-bottom: 8rpx;
}

.next-step-text {
  font-size: 28rpx;
  color: #3E2723;
  font-weight: bold;
  display: block;
  min-width: 0;
  word-break: break-all;
  overflow-wrap: break-word;
}

.goal-info .progress-bar {
  margin-top: 20rpx;
  margin-bottom: 4rpx;
}

.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 12rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #FF80AB;
  border-radius: 12rpx;
  transition: width 0.7s;
}

.empty-state {
  text-align: center;
  padding: 160rpx 0;
  opacity: 0.3;
  animation: pulse 2s infinite;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #3E2723;
  display: block;
}

@keyframes pulse {
  0%, 100% {
    opacity: 0.3;
  }
  50% {
    opacity: 0.5;
  }
}
