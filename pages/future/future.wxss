/* 折叠式未来目标管理页面样式 */
.input-section {
  text-align: center;
}

.section-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #3E2723;
  margin-bottom: 16rpx;
  display: block;
}

.section-subtitle {
  font-size: 24rpx;
  color: #6D4C41;
  font-style: italic;
  margin-bottom: 48rpx;
  display: block;
}

.input-group {
  display: flex;
  gap: 16rpx;
}

.goal-input {
  flex: 1;
  background: rgba(255, 249, 196, 0.5);
  border: 4rpx solid white;
  border-radius: 32rpx;
  padding: 24rpx;
  color: #3E2723;
  font-size: 28rpx;
}

.split-btn {
  background: #6D4C41;
  color: white;
  padding: 24rpx 48rpx;
  border-radius: 32rpx;
  font-weight: bold;
  font-size: 28rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.split-btn[disabled] {
  opacity: 0.5;
}

.quadrant-selector {
  margin-top: 32rpx;
  padding: 20rpx 16rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 24rpx;
  box-sizing: border-box;
}

.selector-label {
  font-size: 24rpx;
  color: #3E2723;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.quadrant-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rpx;
  margin: 0 20% 0 -5%;
  width: 15%;
  max-width: 15%;
  box-sizing: border-box;
  padding: 0;
}

.quadrant-btn-small {
  width: 100%;
  max-width: 100%;
  padding: 16rpx 2rpx;
  border-radius: 16rpx;
  font-size: 16rpx;
  font-weight: bold;
  color: white;
  border: 2rpx solid;
  opacity: 0.7;
  transition: all 0.3s;
  box-sizing: border-box;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
}

.quadrant-btn-small.selected {
  opacity: 1;
  transform: scale(1.05);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.quadrant-btn-small::after {
  border: none;
}

.goal-title-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  width: 100%;
}

/* 标题居中、横向排列，且不溢出 */
.goal-title {
  writing-mode: horizontal-tb;
  display: inline-block;
  white-space: normal;
  word-break: break-all;
  font-size: 36rpx;
  font-weight: bold;
  color: #3E2723;
  max-width: 100%;
  overflow-wrap: break-word;
}

.goal-type-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 板块最右上角的小×删除（贴边） */
.goal-delete-x {
  position: absolute;
  top: 0;
  right: 0;
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  margin: 0;
  line-height: 72rpx;
  font-size: 44rpx;
  color: #999;
  background: transparent;
  border: none;
  border-radius: 0 56rpx 0 24rpx;
  z-index: 10;
}

.goal-delete-x::after {
  border: none;
}

.goal-delete-x:active {
  color: #B71C1C;
  background: rgba(183, 28, 28, 0.1);
}

.goals-list {
  margin-top: 40rpx;
  overflow: visible;
}

.goal-card {
  background: rgba(255, 255, 255, 0.6);
  padding: 40rpx 36rpx 48rpx;
  padding-top: 56rpx;
  border-radius: 64rpx;
  border: 8rpx solid white;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 48rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.goal-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-width: 0;
}

/* 糖果罐：固定宽高，不随外框变化；上下缩小后垂直居中，完成前后大小一致 */
.candy-jar {
  width: 136rpx;
  height: 200rpx;
  flex-shrink: 0;
  align-self: center;
  background: rgba(255, 255, 255, 0.4);
  border: 4rpx solid white;
  border-radius: 0 0 32rpx 32rpx;
  border-top-left-radius: 16rpx;
  border-top-right-radius: 16rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: visible;
}

.jar-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 24rpx;
  background: rgba(255, 255, 255, 0.6);
}

.jar-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 10rpx;
  align-items: flex-end;
  align-content: flex-end;
  overflow: hidden;
}

.candy {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* 掉落动画：从上往下落进罐底 */
.candy-drop {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  animation: candy-fall 650ms cubic-bezier(0.25, 0.1, 0.5, 1) forwards;
}

@keyframes candy-fall {
  0% {
    transform: translate(-50%, -200rpx);
    opacity: 0.4;
  }
  25% {
    transform: translate(-50%, -80rpx);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, 0);
    opacity: 1;
  }
}

.goal-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

/* 标题行：名称居中，右侧为×留空 */
.goal-header {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
  padding-right: 72rpx;
  min-width: 0;
}

.expand-section {
  margin-top: 24rpx;
  width: 100%;
}

.expand-btn {
  font-size: 24rpx;
  color: #6D4C41;
  background: rgba(255, 255, 255, 0.5);
  padding: 12rpx 24rpx;
  border-radius: 50rpx;
  border: none;
  width: 100%;
}

.expand-btn::after {
  border: none;
}

.delete-btn {
  font-size: 22rpx;
  color: #B71C1C;
  background: transparent;
  padding: 4rpx 8rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(183, 28, 28, 0.3);
}

.delete-btn::after {
  border: none;
}

.completed-badge {
  background: #C8E6C9;
  color: #2E7D32;
  padding: 8rpx 24rpx;
  border-radius: 50rpx;
  font-size: 20rpx;
  font-weight: bold;
  width: fit-content;
  animation: bounce 1s infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

.next-step-preview {
  margin-top: 16rpx;
}

/* 展开后：思维导图区域，展示所有子目标（含已完成，可当历史记录查看） */
.mindmap-section {
  margin-top: 24rpx;
  padding: 24rpx 0 0;
  border-top: 2rpx dashed rgba(109, 76, 65, 0.2);
  min-height: 80rpx;
}

.history-label {
  font-size: 24rpx;
  color: #6D4C41;
  opacity: 0.85;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.mindmap-node {
  margin-bottom: 32rpx;
  position: relative;
}

.mindmap-branch {
  width: 4rpx;
  height: 24rpx;
  background: linear-gradient(to bottom, #FF80AB, #B39DDB);
  margin-bottom: 8rpx;
  border-radius: 2rpx;
}

.mindmap-subtitle {
  font-size: 26rpx;
  font-weight: bold;
  color: #6D4C41;
  display: block;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
}

.mindmap-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 16rpx 16rpx 32rpx;
  margin-left: 16rpx;
  border-left: 4rpx solid #FFF176;
  border-radius: 0 24rpx 24rpx 0;
  background: #FFFDE7;
  margin-bottom: 12rpx;
  font-size: 24rpx;
}

.mindmap-step.completed {
  background: #F5F5F5;
  opacity: 0.6;
  text-decoration: line-through;
  font-style: italic;
  border-left-color: #C8E6C9;
}

.mindmap-connector {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FF80AB;
  flex-shrink: 0;
}

.mindmap-step .step-text {
  flex: 1;
  min-width: 0;
  word-break: break-all;
  overflow-wrap: break-word;
  color: #3E2723;
}

.next-step-item {
  background: #FFFDE7;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid #FFF176;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-width: 0;
  overflow: hidden;
}

.next-step-content {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  padding-right: 8rpx;
}

.next-step-label {
  font-size: 20rpx;
  color: #6D4C41;
  opacity: 0.6;
  display: block;
  margin-bottom: 8rpx;
}

.next-step-text {
  font-size: 28rpx;
  color: #3E2723;
  font-weight: bold;
  display: block;
  min-width: 0;
  word-break: break-all;
  overflow-wrap: break-word;
}

.goal-info .progress-bar {
  margin-top: 20rpx;
  margin-bottom: 4rpx;
}

.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 12rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #FF80AB;
  border-radius: 12rpx;
  transition: width 0.7s;
}

.empty-state {
  text-align: center;
  padding: 160rpx 0;
  opacity: 0.3;
  animation: pulse 2s infinite;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #3E2723;
  display: block;
}

@keyframes pulse {
  0%, 100% {
    opacity: 0.3;
  }
  50% {
    opacity: 0.5;
  }
}
