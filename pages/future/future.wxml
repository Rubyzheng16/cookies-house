<!--折叠式未来目标管理页面-->
<view class="container">
  <!-- 标签切换 -->
  <view class="tabs">
    <button 
      class="tab-btn {{tab === 'goal' ? 'active' : ''}}"
      data-tab="goal"
      bindtap="switchTab"
    >
      目标拆解
    </button>
    <button 
      class="tab-btn {{tab === 'skill' ? 'active' : ''}}"
      data-tab="skill"
      bindtap="switchTab"
    >
      技能树
    </button>
  </view>

  <!-- Tab 1: 目标拆解 -->
  <view class="tab-content" wx:if="{{tab === 'goal'}}">
    <!-- 拆解板块：恢复原本样式 -->
    <view class="card input-section">
      <text class="section-title">折叠式未来规划</text>
      <text class="section-subtitle">"将庞大未来封装，只面对最小的一步"</text>
      
      <view class="input-group">
        <input 
          class="goal-input"
          value="{{newGoal}}"
          placeholder="输入你想开启的长期目标..."
          bindinput="onInputChange"
          maxlength="100"
        />
        <button 
          class="split-btn"
          bindtap="generateSteps"
          disabled="{{isLoading || !newGoal}}"
        >
          {{isLoading ? '拆解中...' : '拆解'}}
        </button>
      </view>
    </view>

    <!-- 长期目标板块：tag 展示，右上角添加 -->
    <view class="long-term-section">
      <view class="long-term-header">
        <text class="long-term-title">长期目标</text>
        <button class="long-term-add-btn" bindtap="onAddLongTermGoal">+ 添加</button>
      </view>
      <view class="goal-tags-wrap">
        <view 
          wx:for="{{goals}}" 
          wx:key="id"
          class="goal-tag-row"
        >
          <view 
            class="goal-tag {{item.isExpanded ? 'expanded' : ''}}"
            data-goal-id="{{item.id}}"
            bindtap="toggleExpand"
          >
            <text class="goal-tag-text">{{item.title}}</text>
            <view 
              class="goal-tag-close"
              data-goal-id="{{item.id}}"
              catchtap="deleteGoal"
              aria-label="删除"
            >×</view>
          </view>
          <!-- 展开时显示步骤 -->
          <view wx:if="{{item.isExpanded}}" class="goal-tag-detail">
            <view 
              wx:for="{{item.steps}}" 
              wx:for-item="step"
              wx:key="id"
              class="goal-tag-step {{step.completed ? 'completed' : ''}}"
              data-goal-id="{{item.id}}"
              data-step-id="{{step.id}}"
              data-text="{{step.text}}"
              bindlongpress="editStep"
            >
              <checkbox 
                checked="{{step.completed}}"
                data-goal-id="{{item.id}}"
                data-step-id="{{step.id}}"
                bindtap="completeStep"
              />
              <text class="goal-tag-step-text">{{step.text}}</text>
            </view>
            <view wx:if="{{!item.steps || item.steps.length === 0}}" class="goal-tag-empty-steps">点击上方拆解板块，输入目标后点「拆解」生成步骤</view>
          </view>
        </view>
      </view>
      <view wx:if="{{goals.length === 0}}" class="long-term-empty">
        <text class="long-term-empty-text">暂无长期目标，点击右上角添加</text>
      </view>
    </view>
  </view>

  <!-- Tab 2: 技能树和长期目标 -->
  <view class="tab-content" wx:if="{{tab === 'skill'}}">
    <!-- 技能树板块 -->
    <view class="skill-tree-panels">
      <text class="section-title">技能树</text>
      <view class="panels-grid">
        <view 
          wx:for="{{skillCategories}}" 
          wx:key="id"
          class="panel-card"
          data-category="{{item.id}}"
          bindtap="goToSkillDetail"
        >
          <text class="panel-icon">{{item.icon}}</text>
          <text class="panel-name">{{item.name}}</text>
          <text class="panel-desc">{{item.count}} 项</text>
        </view>
      </view>
    </view>

    <!-- 分析板块 -->
    <view class="skill-analysis-entry" bindtap="goToSkillAnalysis">
      <text class="section-title">分析</text>
      <view class="analysis-card">
        <text class="analysis-hint">查看技能分布与决策分析</text>
        <text class="analysis-arrow">→</text>
      </view>
    </view>
  </view>

  <!-- 输入弹窗 -->
  <input-modal 
    show="{{showInputModal}}"
    bind:close="hideInputModal"
    bind:confirm="handleInputConfirm"
  />
</view>
