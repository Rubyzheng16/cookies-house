/* 可视化状态感知页面样式 */
.tabs {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 40rpx;
}

.tab-btn {
  padding: 24rpx 48rpx;
  border-radius: 50rpx;
  font-weight: bold;
  border: 8rpx solid transparent;
  background: rgba(255, 255, 255, 0.4);
  color: #6D4C41;
  font-size: 28rpx;
  transform: scale(0.9);
  transition: all 0.3s;
}

.tab-btn.active {
  background: #FFF9C4;
  border-color: #6D4C41;
  color: #3E2723;
  transform: scale(1);
}

.chart-section {
  text-align: center;
  padding: 24rpx 24rpx 32rpx !important;
}

.chart-section .section-title {
  font-size: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  color: #3E2723;
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 48rpx;
  display: block;
}

.chart-container {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 48rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 24rpx;
}

.stat-icon {
  font-size: 36rpx;
}

.stat-text {
  font-size: 24rpx;
  color: #3E2723;
  font-weight: bold;
}

.analysis-section {
  background: #FFFDE7;
  border: 4rpx solid rgba(161, 136, 127, 0.3);
  position: relative;
  overflow: hidden;
}

.analysis-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: rgba(109, 76, 65, 0.1);
}

.analysis-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.analysis-icon {
  font-size: 40rpx;
}

.analysis-title {
  color: #6D4C41;
  font-weight: bold;
  font-size: 32rpx;
}

.analysis-content {
  color: #3E2723;
  line-height: 1.8;
  font-style: italic;
  font-size: 28rpx;
}

.analysis-empty {
  text-align: center;
  padding: 32rpx 0;
}

.empty-text {
  color: rgba(62, 39, 35, 0.6);
  font-size: 28rpx;
  margin-bottom: 32rpx;
  display: block;
}

.analyze-btn,
.diary-btn {
  background: #FFD700;
  padding: 16rpx 48rpx;
  border-radius: 50rpx;
  font-weight: bold;
  color: #3E2723;
  font-size: 28rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* 日记板块 */
.diary-section {
  background: #FFFDE7;
  border: 4rpx solid rgba(161, 136, 127, 0.3);
  margin-top: 32rpx;
}

.diary-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.diary-icon {
  font-size: 40rpx;
}

.diary-title {
  color: #6D4C41;
  font-weight: bold;
  font-size: 32rpx;
}

.diary-body {
  padding: 0;
}

.diary-block {
  margin-bottom: 32rpx;
}

.diary-label {
  font-size: 24rpx;
  color: #6D4C41;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.diary-content {
  color: #3E2723;
  line-height: 1.8;
  font-size: 28rpx;
  display: block;
}

.diary-content.insight {
  font-style: italic;
  color: #5D4037;
}

.diary-empty {
  text-align: center;
  padding: 32rpx 0;
}

.diary-empty .empty-text {
  display: block;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: rgba(62, 39, 35, 0.5);
  display: block;
  margin-bottom: 32rpx;
}

/* 日记指令（可折叠，所有人可用） */
.diary-prompt-card {
  margin-top: 32rpx;
  background: #FFFDE7;
  border: 4rpx solid rgba(161, 136, 127, 0.3);
}

.diary-prompt-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.diary-prompt-header:active {
  opacity: 0.8;
}

.diary-prompt-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #6D4C41;
}

.diary-prompt-toggle {
  font-size: 24rpx;
  color: #8D6E63;
}

.diary-prompt-body {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(161, 136, 127, 0.2);
}

.diary-prompt-desc {
  font-size: 26rpx;
  color: #6D4C41;
  line-height: 1.6;
  display: block;
  margin-bottom: 24rpx;
}

.diary-prompt-field {
  margin-bottom: 24rpx;
}

.diary-prompt-label {
  font-size: 26rpx;
  color: #6D4C41;
  margin-bottom: 12rpx;
  display: block;
}

.diary-prompt-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(109, 76, 65, 0.2);
  font-size: 28rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.9);
}

.diary-prompt-actions {
  display: flex;
  gap: 24rpx;
}

.diary-prompt-save,
.diary-prompt-clear {
  flex: 1;
  line-height: 2.2;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.diary-prompt-save::after,
.diary-prompt-clear::after {
  border: none;
}

.diary-prompt-save {
  background: #6D4C41;
  color: #fff;
}

.diary-prompt-clear {
  background: #FFF9C4;
  color: #3E2723;
}

.trends-section {
  text-align: center;
}

.trends-chart {
  height: 384rpx;
  width: 100%;
  background: rgba(109, 76, 65, 0.05);
  border-radius: 32rpx;
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  padding: 0 32rpx 64rpx;
}

.trend-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.bar {
  width: 32rpx;
  border-radius: 16rpx;
  transition: all 0.5s;
  min-height: 20rpx;
}

.bar-label {
  font-size: 16rpx;
  color: #3E2723;
  font-weight: bold;
}

.medals-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx;
  margin-top: 40rpx;
}

.medal-card {
  background: #FFF9C4;
  padding: 32rpx;
  border-radius: 60rpx;
  text-align: center;
  border: 8rpx solid white;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.medal-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.medal-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #3E2723;
  display: block;
  margin-bottom: 8rpx;
}

.medal-desc {
  font-size: 20rpx;
  color: rgba(62, 39, 35, 0.6);
  display: block;
}

/* 心理日记板块（长期分析） */
.counselor-diary-section {
  margin-top: 32rpx;
}

.counselor-diary-content {
  white-space: pre-wrap;
}

.fortune-section {
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.fortune-title {
  color: #3E2723;
  font-size: 28rpx;
  font-weight: bold;
}

/* 丰容板块 */
.enrichment-panels {
  margin-top: 48rpx;
}

.enrichment-panels .section-title {
  margin-bottom: 32rpx;
}

.panels-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.panel-card {
  padding: 32rpx;
  border-radius: 32rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.3);
  border: 4rpx solid rgba(109, 76, 65, 0.2);
  transition: all 0.3s;
}

.panel-card.lit {
  background: #FFF9C4;
  border-color: #6D4C41;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.panel-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.panel-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #3E2723;
  display: block;
}

.panel-desc {
  font-size: 20rpx;
  color: rgba(62, 39, 35, 0.7);
  margin-top: 8rpx;
  display: block;
}

.panel-desc.dim {
  color: rgba(62, 39, 35, 0.4);
}
