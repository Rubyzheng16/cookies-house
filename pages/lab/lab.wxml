<!--可视化状态感知页面-->
<view class="container">
  <!-- 标签切换 -->
  <view class="tabs">
    <button 
      class="tab-btn {{tab === 'daily' ? 'active' : ''}}"
      data-tab="daily"
      bindtap="switchTab"
    >
      当天分析
    </button>
    <button 
      class="tab-btn {{tab === 'trends' ? 'active' : ''}}"
      data-tab="trends"
      bindtap="switchTab"
    >
      长期分析
    </button>
  </view>

  <!-- 当天分析 -->
  <view class="tab-content" wx:if="{{tab === 'daily'}}">
    <!-- 时间消耗 -->
    <view class="card chart-section">
      <text class="section-title">今日时间</text>
      <time-pie-chart entries="{{todayFolder.entries || []}}" />
    </view>

    <!-- 日记指令（可折叠，所有人可用） -->
    <view class="card diary-prompt-card">
      <view class="diary-prompt-header" bindtap="togglePromptCollapse">
        <text class="diary-prompt-title">日记指令</text>
        <text class="diary-prompt-toggle">{{promptCollapsed ? '展开 ▼' : '收起 ▲'}}</text>
      </view>
      <view class="diary-prompt-body" wx:if="{{!promptCollapsed}}">
        <text class="diary-prompt-desc">
          自定义 AI 生成日记时的指令提示词。留空则使用默认指令。
        </text>
        <view class="diary-prompt-field">
          <text class="diary-prompt-label">自定义指令（选填）</text>
          <textarea
            class="diary-prompt-textarea"
            placeholder="此处留空则使用默认指令。可在此输入你的日记风格与要求..."
            value="{{promptInput}}"
            bindinput="onPromptInput"
          />
        </view>
        <view class="diary-prompt-actions">
          <button class="diary-prompt-save" bindtap="saveDiaryPrompt">保存</button>
          <button wx:if="{{promptInput}}" class="diary-prompt-clear" bindtap="clearDiaryPrompt">恢复默认</button>
        </view>
      </view>
    </view>

    <!-- AI 日记 -->
    <view class="card diary-section">
      <view class="diary-header">
        <text class="diary-icon">📔</text>
        <text class="diary-title">今日日记</text>
      </view>
      <view class="diary-body">
        <view wx:if="{{todayFolder && todayFolder.diaryAnalysis}}">
          <view class="diary-block">
            <text class="diary-label">完整日记</text>
            <text class="diary-content">{{todayFolder.diaryAnalysis.diary}}</text>
          </view>
          <view wx:if="{{todayFolder.diaryAnalysis.keyPoints}}" class="diary-block">
            <text class="diary-label">关键要点</text>
            <text class="diary-content">{{todayFolder.diaryAnalysis.keyPoints}}</text>
          </view>
          <view wx:if="{{todayFolder.diaryAnalysis.insights}}" class="diary-block">
            <text class="diary-label">洞察与建议</text>
            <text class="diary-content insight">{{todayFolder.diaryAnalysis.insights}}</text>
          </view>
        </view>
        <view wx:else class="diary-empty">
          <text class="empty-text">今天的日记还没写呢...</text>
          <text class="empty-hint">添加碎碎念和任务后，AI 会帮你生成完整日记</text>
        </view>
        <button class="diary-btn" bindtap="generateDiary">
          {{todayFolder && todayFolder.diaryAnalysis ? '✨ 重新生成' : '✨ 生成今日日记'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 长期分析 -->
  <view class="tab-content" wx:if="{{tab === 'trends'}}">
    <!-- 幸运饼干 -->
    <view class="fortune-section">
      <text class="fortune-title">幸运饼干时刻</text>
      <fortune-cookie 
        todayFortune="{{todayFortune}}"
        loading="{{fortuneLoading}}"
        bind:fetch="onFortuneFetch"
        bind:complete="onFortuneComplete"
      />
    </view>

    <!-- 丰容板块 -->
    <view class="enrichment-panels">
      <text class="section-title">丰容板块</text>
      <view class="panels-grid">
        <view 
          wx:for="{{enrichmentPanels}}" 
          wx:key="id"
          class="panel-card {{item.lit ? 'lit' : ''}}"
          data-category="{{item.id}}"
          bindtap="goToPanelDetail"
        >
          <text class="panel-icon">{{item.icon}}</text>
          <text class="panel-name">{{item.name}}</text>
          <text class="panel-desc" wx:if="{{item.lit}}">已完成 {{item.count}} 次</text>
          <text class="panel-desc dim" wx:else>完成该板块任务即可点亮</text>
        </view>
      </view>
    </view>

    <!-- 心理日记（与今日日记同款布局） -->
    <view class="card diary-section counselor-diary-section">
      <view class="diary-header">
        <text class="diary-icon">📖</text>
        <text class="diary-title">心理日记</text>
      </view>
      <view class="diary-body">
        <view wx:if="{{counselorDiary}}">
          <view class="diary-block">
            <text class="diary-label">完整日记</text>
            <text class="diary-content counselor-diary-content">{{counselorDiary}}</text>
          </view>
        </view>
        <view wx:else class="diary-empty">
          <text class="empty-text">心理日记还没生成...</text>
          <text class="empty-hint">根据所有记录，以心理咨询师视角生成深度心理日记（约 1500 字）</text>
        </view>
        <button class="diary-btn" bindtap="generateCounselorDiary" disabled="{{counselorLoading}}">
          {{counselorDiary ? '✨ 重新生成' : '✨ 生成心理日记'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 输入弹窗 -->
  <input-modal 
    show="{{showInputModal}}"
    bind:close="hideInputModal"
    bind:confirm="handleInputConfirm"
  />
</view>
