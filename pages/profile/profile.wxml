<!--个人中心页面-->
<view class="container">
  <!-- 用户信息卡片 -->
  <view class="card user-card">
    <view class="avatar-container">
      <image 
        wx:if="{{userInfo.avatarUrl}}"
        class="avatar"
        src="{{userInfo.avatarUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="avatar avatar-placeholder">🍪</view>
    </view>
    <text class="user-name">{{userInfo.nickName || '首席烘焙师'}}</text>
    <text class="user-desc">让生活每一分钟都带有甜味</text>
  </view>

  <!-- 设置列表 -->
  <view class="card settings-card">
    <view class="settings-header">
      <text class="settings-title">基本设置</text>
      <text class="settings-version">版本 v1.0.4</text>
    </view>
    <view class="settings-list">
      <button 
        class="settings-item settings-item-link"
        bindtap="goProfileEdit"
      >
        <text>个人资料</text>
        <text class="settings-arrow">›</text>
      </button>

      <button 
        class="settings-item settings-item-link"
        bindtap="goAiSettings"
      >
        <text>AI 助手密钥</text>
        <text class="settings-arrow">›</text>
      </button>

      <button 
        class="settings-item settings-item-link"
        bindtap="openDataBackupMenu"
      >
        <text>数据与备份</text>
        <text class="settings-arrow">›</text>
      </button>

      <button 
        class="settings-item settings-item-row"
        hover-class="none"
      >
        <text class="settings-row-label">通知开关</text>
        <switch 
          class="settings-switch"
          checked="{{notificationOn}}" 
          bindchange="onNotificationChange" 
          color="#6D4C41"
        />
      </button>
    </view>
  </view>
</view>
