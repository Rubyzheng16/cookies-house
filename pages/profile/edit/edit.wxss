.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.avatar-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 12rpx solid #FFF9C4;
  margin-bottom: 24rpx;
}

.avatar-preview {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  background: linear-gradient(135deg, #FFF9C4 0%, #FFECB3 100%);
}

.nickname-card .nickname-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 16rpx 0;
}

.nickname-card .label {
  font-size: 28rpx;
  color: #6D4C41;
}

.nickname-card .value {
  font-size: 32rpx;
  font-weight: bold;
  color: #3E2723;
}

.edit-btn {
  width: 100%;
  background: #FFF9C4;
  color: #3E2723;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 24rpx;
  border: none;
  line-height: 2.2;
}

.edit-btn::after {
  border: none;
}

.nickname-edit {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0,0,0,0.06);
}

.nickname-input {
  width: 100%;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #FFF9C4;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.nickname-actions {
  display: flex;
  gap: 24rpx;
}

.edit-btn.small {
  flex: 1;
  line-height: 2;
}

.edit-btn.small.primary {
  background: #6D4C41;
  color: #fff;
}

.logout-card {
  margin-top: 48rpx;
}

.logout-btn {
  width: 100%;
  background: transparent;
  color: #B71C1C;
  font-size: 28rpx;
  border: 2rpx solid rgba(183, 28, 28, 0.4);
  border-radius: 24rpx;
  line-height: 2.2;
}

.logout-btn::after {
  border: none;
}
