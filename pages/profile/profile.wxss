/* 个人中心页面样式 */
.user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-container {
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  border: 16rpx solid #FFF9C4;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
  margin-bottom: 32rpx;
}

.avatar {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  background: linear-gradient(135deg, #FFF9C4 0%, #FFECB3 100%);
}

.user-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #3E2723;
  margin-bottom: 8rpx;
}

.user-desc {
  font-size: 24rpx;
  color: #6D4C41;
  font-style: italic;
}

.settings-card {
  background: rgba(255, 255, 255, 0.4);
  overflow: hidden;
}

.settings-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 16rpx;
  margin-bottom: 32rpx;
}

.settings-title {
  color: #3E2723;
  font-weight: bold;
  font-size: 32rpx;
}

.settings-version {
  font-size: 24rpx;
  color: #999999;
}

.settings-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.settings-item {
  width: 100%;
  box-sizing: border-box;
  text-align: left;
  background: rgba(255, 255, 255, 0.8);
  padding: 32rpx;
  border-radius: 32rpx;
  color: #3E2723;
  font-weight: bold;
  font-size: 28rpx;
  border: none;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.settings-item-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.settings-item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  min-width: 0;
}

.settings-row-label {
  flex: 1;
  min-width: 0;
}

.settings-switch {
  flex-shrink: 0;
}

.settings-arrow {
  font-size: 36rpx;
  color: #999;
}
