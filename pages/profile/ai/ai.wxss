.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3E2723;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 26rpx;
  color: #6D4C41;
  line-height: 1.7;
  margin-bottom: 32rpx;
}

.field {
  margin-bottom: 32rpx;
}

.field-label {
  font-size: 26rpx;
  color: #6D4C41;
  margin-bottom: 12rpx;
  display: block;
}

.field-input {
  width: 100%;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #FFF9C4;
  font-size: 28rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.9);
}

.hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9E9E9E;
}

.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.btn {
  flex: 1;
  line-height: 2.2;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: #6D4C41;
  color: #fff;
}

.btn.secondary {
  background: #FFF9C4;
  color: #3E2723;
}

.btn.link {
  width: 100%;
  margin-top: 24rpx;
  background: transparent;
  color: #B71C1C;
  font-size: 26rpx;
  font-weight: normal;
}

.tips-card .tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #3E2723;
  margin-bottom: 16rpx;
}

.tips-card .tips-text {
  font-size: 24rpx;
  color: #6D4C41;
  line-height: 1.8;
  white-space: pre-wrap;
}

