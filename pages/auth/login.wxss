.login-container {
  min-height: 100vh;
  background: transparent;
  padding: 80rpx 48rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}

.logo-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.logo-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #fff9c4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.12);
}

.logo-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #3e2723;
}

.logo-subtitle {
  font-size: 24rpx;
  color: #6d4c41;
}

.login-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.login-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3e2723;
}

.login-desc {
  font-size: 24rpx;
  color: #795548;
  line-height: 1.7;
}

.login-button {
  margin-top: 8rpx;
  width: 100%;
  min-width: 520rpx;
  background: #6d4c41;
  border-radius: 999rpx;
  padding: 24rpx 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #fff;
  font-weight: bold;
  font-size: 30rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.18);
  white-space: nowrap;
}

.login-button-text {
  white-space: nowrap;
}

.login-button[disabled] {
  opacity: 0.7;
}

.login-button-icon {
  font-size: 40rpx;
}

.login-footer {
  margin-top: auto;
}

.login-tip {
  font-size: 20rpx;
  color: rgba(62, 39, 35, 0.7);
  line-height: 1.6;
}

