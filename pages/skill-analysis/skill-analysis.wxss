/* 技能分析页 */
.container {
  padding: 32rpx;
  min-height: 100vh;
  background: #FCE4EC;
}

.header {
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #3E2723;
}

.card {
  background: rgba(255, 255, 255, 0.6);
  border: 4rpx solid rgba(109, 76, 65, 0.15);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #6D4C41;
  display: block;
  margin-bottom: 24rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  gap: 16rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  background: rgba(255, 249, 196, 0.5);
  border-radius: 24rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #6D4C41;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(62, 39, 35, 0.7);
  margin-top: 8rpx;
  display: block;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.category-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 24rpx;
}

.category-icon {
  font-size: 40rpx;
}

.category-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: bold;
  color: #3E2723;
}

.category-count {
  font-size: 24rpx;
  color: rgba(62, 39, 35, 0.7);
}

.empty {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(62, 39, 35, 0.6);
  display: block;
}

.empty-hint {
  font-size: 24rpx;
  color: rgba(62, 39, 35, 0.4);
  margin-top: 16rpx;
  display: block;
}
