<!-- 丰容板块详情 -->
<view class="container">
  <view wx:if="{{categoryInfo}}" class="header">
    <view class="header-main">
      <text class="header-icon">{{categoryInfo.icon}}</text>
      <text class="header-title">{{categoryInfo.name}}</text>
      <text class="header-desc">共完成 {{history.length}} 次</text>
      <view class="header-actions">
        <button class="header-btn" bindtap="onAdd">+ 添加</button>
        <button class="header-btn secondary" bindtap="onEdit">编辑</button>
      </view>
    </view>
  </view>

  <view class="history-list">
    <view 
      wx:for="{{history}}" 
      wx:key="date"
      class="history-item"
    >
      <view class="history-item-header">
        <text class="history-date">{{item.date}}</text>
        <view 
          wx:if="{{editMode}}" 
          class="history-delete-btn" 
          data-index="{{index}}" 
          bindtap="onDeleteItem"
        >×</view>
      </view>
      <text class="history-content">{{item.content}}</text>
    </view>
  </view>

  <view wx:if="{{history.length === 0}}" class="empty">
    <text class="empty-text">暂无完成记录</text>
    <text class="empty-hint">完成今日幸运饼干中该板块的任务即可点亮</text>
  </view>
</view>
