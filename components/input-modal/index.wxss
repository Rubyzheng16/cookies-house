/* 输入弹窗组件样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
}

.modal-content {
  width: 90%;
  max-width: 700rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.card {
  background: white;
  border-radius: 40rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.3);
}

.workbench {
  position: relative;
  overflow: visible;
  box-sizing: border-box;
}

.workbench-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  display: flex;
  overflow: hidden;
}

.workbench-top::before {
  display: none;
}

.input-area {
  position: relative;
  margin-top: 32rpx;
  width: 100%;
  box-sizing: border-box;
  background: rgba(255, 249, 196, 0.9);
  border-radius: 40rpx 40rpx 0 0;
  padding-top: 0;
  overflow: visible;
}

.input-area::before {
  content: '';
  position: absolute;
  top: -70rpx;
  left: 0;
  right: 0;
  height: 66rpx;
  background: white;
  border-radius: 40rpx 40rpx 0 0;
  overflow: hidden;
  background-image: 
    radial-gradient(circle at 45rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx),
    radial-gradient(circle at 135rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx),
    radial-gradient(circle at 225rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx),
    radial-gradient(circle at 315rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx),
    radial-gradient(circle at 405rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx),
    radial-gradient(circle at 495rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx),
    radial-gradient(circle at 585rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx),
    radial-gradient(circle at 675rpx 66rpx, rgba(255, 249, 196, 0.9) 33rpx, white 33rpx);
  background-size: 90rpx 66rpx;
  background-position: 0 0, 90rpx 0, 180rpx 0, 270rpx 0, 360rpx 0, 450rpx 0, 540rpx 0, 630rpx 0;
  background-repeat: repeat-x;
  z-index: 1;
}

.input-textarea {
  width: 100%;
  min-height: 224rpx;
  background: transparent;
  border: none;
  color: #3E2723;
  font-size: 36rpx;
  padding: 16rpx;
  line-height: 1.6;
  text-align: left;
}

.input-icons {
  position: absolute;
  bottom: 16rpx;
  right: 20rpx;
  display: flex;
  gap: 20rpx;
  z-index: 10;
}

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s;
}

.icon-btn:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.6);
}

.icon {
  font-size: 40rpx;
}

.ref-toggle {
  display: flex;
  justify-content: center;
  margin: 32rpx 0;
}

.ref-btn {
  background: rgba(161, 136, 127, 0.2);
  padding: 8rpx 32rpx;
  border-radius: 50rpx;
  font-size: 20rpx;
  color: #3E2723;
  font-weight: bold;
  border: none;
}

.ref-content {
  margin-bottom: 48rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 60rpx;
  border: 4rpx dashed rgba(161, 136, 127, 0.4);
}

.ref-quadrant-visual {
  position: relative;
  background: rgba(255, 255, 255, 0.4);
  padding: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  min-height: 600rpx;
}

.ref-quadrant-container {
  position: relative;
  width: 100%;
  height: 600rpx;
}

.ref-quadrant-line-horizontal {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 2rpx;
  background: rgba(62, 39, 35, 0.3);
  z-index: 1;
  transform: translateY(-50%);
}

.ref-quadrant-line-vertical {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: rgba(62, 39, 35, 0.3);
  z-index: 1;
  transform: translateX(-50%);
}

.ref-quadrant-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  width: 100%;
  height: 100%;
  position: relative;
  z-index: 0;
}

.ref-quadrant-cell {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  padding: 16rpx;
  position: relative;
  border: 1rpx solid rgba(62, 39, 35, 0.1);
  overflow-y: auto;
}

.ref-quadrant-1 {
  background: rgba(255, 128, 171, 0.1);
  border-top-right-radius: 24rpx;
}

.ref-quadrant-2 {
  background: rgba(129, 199, 132, 0.1);
  border-top-left-radius: 24rpx;
}

.ref-quadrant-3 {
  background: rgba(255, 235, 118, 0.1);
  border-bottom-right-radius: 24rpx;
}

.ref-quadrant-4 {
  background: rgba(179, 157, 219, 0.1);
  border-bottom-left-radius: 24rpx;
}

.ref-quadrant-cell-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
  width: 100%;
}

.ref-quadrant-cell-title {
  font-size: 22rpx;
  font-weight: bold;
  color: #3E2723;
  line-height: 1.3;
  text-align: center;
}

.ref-quadrant-cell-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: 100%;
  flex: 1;
}

.ref-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.ref-detail-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 20rpx;
  line-height: 1.4;
}

.ref-detail-label {
  color: #6D4C41;
  font-weight: bold;
  font-size: 18rpx;
}

.ref-detail-text {
  color: rgba(62, 39, 35, 0.8);
  font-size: 18rpx;
}

.quadrant-buttons {
  display: flex;
  flex-direction: row;
  gap: 6rpx;
  margin: 16rpx 0 24rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  padding: 0;
  justify-content: space-between;
}

.quadrant-btn {
  flex: 1;
  min-width: 0;
  max-width: calc(25% - 4.5rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 4rpx;
  border-radius: 16rpx;
  border: none;
  transition: all 0.3s;
  opacity: 0.8;
  box-sizing: border-box;
  overflow: hidden;
}

.quadrant-btn.selected {
  opacity: 1;
  transform: scale(1.02);
  box-shadow: 0 0 0 4rpx white;
}

.quadrant-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
  flex-shrink: 0;
}

.quadrant-label {
  font-size: 20rpx;
  font-weight: bold;
  color: #3E2723;
  text-align: center;
  line-height: 1.2;
  word-break: keep-all;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  max-width: 100%;
  padding: 0 2rpx;
}

.confirm-btn {
  width: calc(100% - 48rpx);
  max-width: calc(100% - 48rpx);
  padding: 24rpx 32rpx;
  border-radius: 32rpx;
  font-weight: bold;
  color: white;
  border: none;
  font-size: 28rpx;
  margin: 24rpx auto 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
  display: block;
}

.confirm-btn.active {
  background-color: #FFB74D;
  box-shadow: 0 4rpx 16rpx rgba(255, 183, 77, 0.3);
}

.confirm-btn.disabled {
  background-color: #E0E0E0;
  color: #999999;
  opacity: 0.6;
}

.confirm-btn::after {
  border: none;
}

.baking-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(4rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.baking-modal {
  background: white;
  padding: 64rpx;
  border-radius: 80rpx;
  text-align: center;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.3);
  border: 16rpx solid #FFF9C4;
}

.baking-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 32rpx;
  animation: pulse 1s infinite;
}

.baking-text {
  color: #3E2723;
  font-weight: bold;
  font-size: 40rpx;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
}
