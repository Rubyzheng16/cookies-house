/* 幸运饼干组件：图片版 */
.fortune-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cookie-wrapper {
  position: relative;
  width: 400rpx;
  height: 280rpx;
  transition: transform 0.3s;
}

.cookie-wrapper.loading {
  animation: pulse 1s infinite;
}

.cookie-whole,
.cookie-broken {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cookie-img {
  width: 100%;
  height: 100%;
}

.cookie-img.whole {
  max-width: 320rpx;
  max-height: 240rpx;
}

.cookie-img.broken {
  max-width: 400rpx;
  max-height: 280rpx;
}

/* 破开饼干：字条区域 overlay，AI 文字叠在图片字条上 */
.cookie-broken {
  position: relative;
}

/* 字条 overlay：叠在破开饼干图片的字条区域，可据实际图片调整 top/left/width */
.fortune-slip-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 70%;
  max-width: 260rpx;
  min-height: 120rpx;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  /* 若图片字条为透明/留白，可取消下面注释以显示纸质感 */
  /* background: rgba(255, 255, 255, 0.92); */
  /* box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08); */
}

.fortune-text {
  font-size: 22rpx;
  color: #1565C0;
  font-family: serif;
  line-height: 1.5;
  text-align: center;
  word-break: break-word;
}

.fortune-hint {
  font-size: 20rpx;
  color: rgba(62, 39, 35, 0.4);
  margin-top: 16rpx;
}

.complete-wrap {
  margin-top: 24rpx;
}

.complete-btn {
  font-size: 26rpx;
  color: #3E2723;
  background: #FFF9C4;
  border: 4rpx solid #6D4C41;
  border-radius: 48rpx;
  padding: 16rpx 48rpx;
}

.complete-btn::after {
  border: none;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(0.95);
  }
}
