/* 幸运饼干组件样式 */
.fortune-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cookie-wrapper {
  position: relative;
  width: 320rpx;
  height: 192rpx;
  transition: transform 0.3s;
}

.cookie-wrapper.loading {
  animation: pulse 1s infinite;
}

.cookie-whole {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cookie-icon {
  font-size: 120rpx;
}

.cookie-broken {
  position: relative;
  width: 100%;
  height: 100%;
}

.cookie-half {
  position: absolute;
  width: 50%;
  height: 100%;
  background: #FFCC80;
  border: 2rpx solid #E65100;
}

.cookie-half.left {
  left: -40rpx;
  top: 0;
  border-radius: 0 0 0 32rpx;
  transform: rotate(-15deg);
}

.cookie-half.right {
  right: -40rpx;
  top: 0;
  border-radius: 0 0 32rpx 0;
  transform: rotate(15deg);
}

.fortune-paper {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(-2deg);
  background: white;
  padding: 24rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  border: 2rpx solid #E3F2FD;
  max-width: 85%;
  z-index: 10;
}

.fortune-text {
  font-size: 24rpx;
  color: #1565C0;
  font-family: serif;
  line-height: 1.4;
  text-align: center;
  display: block;
}

.fortune-hint {
  font-size: 20rpx;
  color: rgba(62, 39, 35, 0.4);
  margin-top: 16rpx;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(0.95);
  }
}
