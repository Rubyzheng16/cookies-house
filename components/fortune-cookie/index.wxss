/* 幸运饼干组件：图片版 */
.fortune-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cookie-wrapper {
  position: relative;
  width: 520rpx;
  height: 380rpx;
  transition: transform 0.3s;
}

.cookie-wrapper.loading {
  animation: pulse 1s infinite;
}

.cookie-whole,
.cookie-broken {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cookie-img {
  width: 100%;
  height: 100%;
}

.cookie-img.whole {
  max-width: 320rpx;
  max-height: 240rpx;
}

.cookie-img.broken {
  max-width: 520rpx;
  max-height: 380rpx;
}

/* 破开饼干：字条区域 overlay，AI 文字叠在图片字条上 */
.cookie-broken {
  position: relative;
}

/* 字条 overlay：横条样式，不透明背景，宽度够用即可 */
.fortune-slip-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 360rpx;
  min-height: 100rpx;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  border: 2rpx solid rgba(109, 76, 65, 0.2);
}

.fortune-text {
  font-size: 24rpx;
  color: #1565C0;
  font-family: serif;
  line-height: 1.6;
  text-align: center;
  word-break: break-word;
}

.fortune-hint {
  font-size: 20rpx;
  color: rgba(62, 39, 35, 0.4);
  margin-top: 16rpx;
}

.complete-wrap {
  margin-top: 24rpx;
}

.complete-btn {
  font-size: 26rpx;
  color: #3E2723;
  background: #FFF9C4;
  border: 4rpx solid #6D4C41;
  border-radius: 48rpx;
  padding: 16rpx 48rpx;
}

.complete-btn::after {
  border: none;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(0.95);
  }
}
