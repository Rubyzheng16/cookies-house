<!--幸运饼干组件：点击前用完整饼干图，点击后破开饼干图+字条文字-->
<view class="fortune-container">
  <view 
    class="cookie-wrapper {{loading ? 'loading' : ''}}"
    bindtap="breakCookie"
  >
    <!-- 点击前：完整饼干图片 -->
    <view wx:if="{{!isBroken}}" class="cookie-whole">
      <image 
        class="cookie-img whole" 
        src="{{imgWhole}}" 
        mode="aspectFit"
      />
    </view>
    <!-- 点击后：破开饼干图片 + 字条上的 AI 文字 -->
    <view wx:else class="cookie-broken">
      <image 
        class="cookie-img broken" 
        src="{{imgBroken}}" 
        mode="aspectFit"
      />
      <view class="fortune-slip-overlay">
        <text class="fortune-text">{{todayFortune.content}}</text>
      </view>
    </view>
  </view>
  <text class="fortune-hint">
    {{isBroken ? '合上碎片' : loading ? '正在揉面...' : '点击咔嚓一声，领个小任务'}}
  </text>
  <view wx:if="{{isBroken && todayFortune && todayFortune.content && !todayFortune.completed}}" class="complete-wrap">
    <button class="complete-btn" bindtap="onComplete">我完成了 ✨</button>
  </view>
</view>
