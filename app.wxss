/* 全局样式 */
page {
  background-color: #FCE4EC;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
  color: #3E2723;
}

/* 通用容器 */
.container {
  padding: 20rpx;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* 通用卡片样式 */
.card {
  background: rgba(255, 249, 196, 0.9);
  border-radius: 80rpx;
  padding: 40rpx 24rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  border: 8rpx solid white;
  box-sizing: border-box;
  overflow: visible;
}

/* 按钮样式 */
.btn {
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  font-weight: bold;
  text-align: center;
  transition: all 0.3s;
}

.btn-primary {
  background-color: #6D4C41;
  color: white;
}

.btn-disabled {
  background-color: #CCCCCC;
  color: #999999;
  opacity: 0.5;
}

/* 文本输入 */
.input {
  background-color: rgba(255, 249, 196, 0.5);
  border: 2rpx solid white;
  border-radius: 40rpx;
  padding: 24rpx;
  color: #3E2723;
}
